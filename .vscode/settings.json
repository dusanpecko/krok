{
  "css.lint.unknownAtRules": "ignore",

  // Appka (Next.js) je v podpriečinku app/ — ESLint si sám nájde jeho flat config
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Používaj TypeScript zo závislostí projektu (app/node_modules), nie z VS Code
  "typescript.tsdk": "app/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Pri uložení automaticky opraviť to, čo ESLint vie (poradie importov a pod.)
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Tailwind IntelliSense aj v pomocných util-funkciách (cn/cva)
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
